{
  "expo": {
    "name": "My Notes App",
    "slug": "mynotesapp-eve-01",
    "version": "1.0.0",
    "platforms": [
      "android",
      "ios"
    ],
    "orientation": "portrait",
    "icon": "./assets/images/TRUESOULS.png",
    "scheme": "faburadanotetakingapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/TRUESOULS.png",
        "backgroundImage": "./assets/images/TRUESOULS.png",
        "monochromeImage": "./assets/images/TRUESOULS.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.eve_01.mynotesapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/TRUESOULS.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/TRUESOULS.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "82d522d2-0dd9-46b1-8380-9936db616f75"
      }
    }
  }
}
